# Maintainer: Vanguard Arts SRL <https://vanguardarts.vip/>
pkgname=volume-booster
pkgver=1.1.4
pkgrel=1
pkgdesc="System tray volume booster for quiet audio (PipeWire/PulseAudio software gain)"
arch=('any')
url="https://github.com/VanguardArts/volume-booster"
license=('MIT')
depends=('python-pyqt6' 'libpulse' 'pipewire-pulse')
source=("$pkgname-$pkgver.tar.gz::https://github.com/VanguardArts/volume-booster/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 volume_booster.py "$pkgdir/usr/bin/volume-booster"
    install -Dm644 packaging/volume-booster.desktop \
        "$pkgdir/usr/share/applications/volume-booster.desktop"
    install -Dm644 packaging/volume-booster.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/volume-booster.svg"
    for sz in 16 24 32 48 64 96 128 256 512; do
        install -Dm644 "packaging/icons/hicolor/${sz}x${sz}/apps/volume-booster.png" \
            "$pkgdir/usr/share/icons/hicolor/${sz}x${sz}/apps/volume-booster.png"
    done
}
